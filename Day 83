#include <stdio.h>

#define MAX 1000

int main() {
    int n;
    scanf("%d", &n);

    int arr[MAX];
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    int prefixSum = 0;
    int maxLen = 0;

    // Hash map simulation
    int hash[2001];  // range for prefix sum
    for (int i = 0; i < 2001; i++) hash[i] = -2;

    hash[1000] = -1; // prefix sum 0 at index -1

    for (int i = 0; i < n; i++) {
        prefixSum += arr[i];

        int index = prefixSum + 1000;

        if (hash[index] != -2) {
            int length = i - hash[index];
            if (length > maxLen)
                maxLen = length;
        } else {
            hash[index] = i;
        }
    }

    printf("%d\n", maxLen);

    return 0;
}
